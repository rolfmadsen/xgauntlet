{
  "project_name": "xgauntlet",
  "version": "0.4.0",
  "layers": [
    {
      "name": "core",
      "patterns": ["src/**"],
      "allowed_dependencies": ["core"]
    }
  ],
  "boundary_rules": [],
  "protected_paths": [
    {
      "pattern": "docs/adr/**",
      "description": "Accepted Architecture Decision Records (ADRs) are authoritative and immutable"
    },
    {
      "pattern": "spec.md",
      "description": "Macro system specification and invariants"
    }
  ],
  "allowed_commands": [
    "cargo test",
    "cargo check",
    "cargo clippy",
    "cargo fmt",
    "xgauntlet verify",
    "git status",
    "git diff",
    "git log"
  ]
}

