{
  "agent-gauntlet-gatekeeper": {
    "PreInvocation": [
      {
        "hooks": [
          {
            "command": "xgauntlet telemetry --format antigravity-hook",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "xgauntlet hook antigravity",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "enabled": true
  }
}
